# CAPPINNO Mobility Nexus Environment Configuration

# App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobility_nexus?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mobility_nexus
POSTGRES_PORT=5432

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-change-in-production-cappinno-2026
JWT_EXPIRATION=7d
INVITATION_TOKEN_SECRET=invitation-secret-cappinno-mobility-nexus

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
