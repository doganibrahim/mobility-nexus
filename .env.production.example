# ==============================================================================
# CAPPINNO Mobility Nexus - Production Hardened Environment Template (.env.production.example)
# Hardening Standard: OWASP Top 10, Multi-Tenant Data Isolation, TLS v1.3 Strict
# Maintenance Guarantee: 30-Day Post-Launch Free Maintenance Warranty Active
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3001
APP_URL=https://mobilitynexus.cappinno.eu
API_URL=https://api.mobilitynexus.cappinno.eu/api/v1

# Production PostgreSQL Database (Strict SSL Mode Enforced)
# Note: Ensure sslmode=require and TLS v1.3 is enforced on production host
DATABASE_URL=postgresql://cappinno_prod_user:CHANGE_ME_SECURE_PASSWORD@prod-db.mobilitynexus.cappinno.eu:5432/mobility_nexus_prod?sslmode=require
DATABASE_SSL=true
POSTGRES_DB=mobility_nexus_prod
POSTGRES_PORT=5432

# Production Authentication & Cryptographic Keys (MUST BE RANDOMLY GENERATED 64-CHAR STRINGS)
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_ENTROPY_JWT_SECRET_2026_PROD
JWT_EXPIRATION=7d
INVITATION_TOKEN_SECRET=CHANGE_ME_64_CHAR_HEX_INVITATION_SECRET_PROD

# Platform Admin Access Controls
ADMIN_EMAILS=ibrahimdogan.js@gmail.com,admin@cappinno.eu
NEXT_PUBLIC_ADMIN_EMAILS=ibrahimdogan.js@gmail.com,admin@cappinno.eu
ADMIN_SECRET_KEY=CHANGE_ME_64_CHAR_ADMIN_SECRET_KEY_PROD
NEXT_PUBLIC_ADMIN_SECRET_KEY=CHANGE_ME_64_CHAR_ADMIN_SECRET_KEY_PROD

# API Rate Limiting & DoS Protection (NestJS ThrottlerGuard + Next.js Middleware)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cloudflare R2 / S3 Secure Object Storage
CLOUDFLARE_R2_ACCOUNT_ID=CHANGE_ME_PROD_R2_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=CHANGE_ME_PROD_R2_ACCESS_KEY
CLOUDFLARE_R2_SECRET_ACCESS_KEY=CHANGE_ME_PROD_R2_SECRET_KEY
CLOUDFLARE_R2_BUCKET_NAME=cappinno-mobility-nexus-prod
CLOUDFLARE_R2_PUBLIC_DOMAIN=assets.mobilitynexus.cappinno.eu

# Production Hardening Checklist Verification Flag
PRODUCTION_HARDENING_LOCKED=true
SLA_MAX_LATENCY_P95_MS=500
WARRANTY_30_DAY_ACTIVE=true
