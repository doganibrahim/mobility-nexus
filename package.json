{
  "name": "mobility-nexus",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "lightningcss": "*",
    "@next/swc-linux-x64-gnu": "*",
    "@next/swc-linux-x64-musl": "*"
  },
  "packageManager": "pnpm@9.15.4",
  "description": "ErasmusMobility - Erasmus Mobility Management as a Service (EMaaS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:all": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter @mobility-nexus/types build && pnpm --filter api build && pnpm --filter web build",
    "start": "pnpm --filter web start",
    "start:web": "pnpm --filter web start",
    "start:api": "pnpm --filter api start:prod",
    "lint": "pnpm -r run lint --if-present",
    "test": "pnpm -r run test --if-present"
  },
  "keywords": [
    "erasmus",
    "mobility",
    "vet",
    "ka121",
    "ka122",
    "saas",
    "multi-tenant"
  ],
  "author": "ErasmusMobility",
  "license": "UNLICENSED"
}
